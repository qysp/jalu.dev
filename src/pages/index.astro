---
import ExternalLink from "@components/ExternalLink.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { site } from "@data/site";
---

<BaseLayout>
  <main class="flex flex-col gap-10">
    <header>
      <h1 class="text-name font-medium tracking-[-0.015em]">{site.name}</h1>
      <p class="text-ink-2 mt-3 text-pretty">
        {site.role} at <ExternalLink href={site.employer.href}
          >{site.employer.name}</ExternalLink
        >. Based in {site.country}.
      </p>
    </header>

    {
      /* role="list" because Tailwind's preflight sets list-style: none, which
        makes Safari/VoiceOver drop the list semantics. */
    }
    <ul
      role="list"
      class="text-link flex flex-col items-start gap-1.5 font-mono"
    >
      {
        site.links.map((link) =>
          link.href.startsWith("http") ? (
            <li>
              {/* py-1 lifts the tap target clear of the 24px floor in
                  WCAG 2.5.8; the text alone is ~23px tall. */}
              <ExternalLink href={link.href} class="py-1">
                {link.label}
              </ExternalLink>
            </li>
          ) : (
            <li>
              <a href={link.href} class="inline-block py-1">
                {link.label}
              </a>
            </li>
          ),
        )
      }
    </ul>
  </main>

  <footer class="rule-pride text-meta text-ink-2 pt-5">
    <p>Built with Astro. Set in Newsreader.</p>
    {
      /* Only ever seen by someone browsing with scripting disabled — on a page
        that ships none regardless. See the custom variant in global.css. */
    }
    <p class="scripting-none:block mt-1 hidden">
      JavaScript is off in your browser. There was never any here.
    </p>
  </footer>
</BaseLayout>
