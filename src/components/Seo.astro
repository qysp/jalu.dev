---
import { site } from "@data/site";

/**
 * astro.config.mjs is the single source of truth for the origin. Without it
 * every canonical and og:url below would quietly become a relative path, so
 * fail the build loudly rather than shipping broken metadata.
 */
if (!Astro.site) {
  throw new Error(
    "astro.config.mjs must set `site` — canonical and OG URLs need an absolute origin.",
  );
}

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<title>{site.title}</title>
<meta name="description" content={site.description} />
<link rel="canonical" href={canonical.href} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="jalu.dev" />
<meta property="og:title" content={site.title} />
<meta property="og:description" content={site.description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogImage.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={site.title} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
